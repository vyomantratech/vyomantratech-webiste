<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /verify/

  # If requested path is not an existing file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Map /verify/VYOM-XXXX to index.html?id=VYOM-XXXX
  RewriteRule ^([a-zA-Z0-9_\-]+)/?$ index.html?id=$1 [QSA,L]
</IfModule>
