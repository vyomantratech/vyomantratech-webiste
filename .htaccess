# =======================================================================
# VYOMANTRA TECHNOLOGIES - HOSTINGER PRODUCTION CONFIG
# Clean Extensionless URLs (.html Removal), HTTPS, Caching & Security
# =======================================================================

Options -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # FastCGI / PHP-FPM Authorization Header Forwarding (Crucial for Hostinger API Auth)
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # 0. Never serve the .git folder
  RewriteRule ^\.git - [F,L]

  # 1. Force HTTPS on Production (exclude localhost / 127.0.0.1)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. Clean Root /index.html -> /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^(.*)index(?:\.html)?$ / [R=301,L]

  # 3. Clean Subfolder index: /dir/index.html -> /dir/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)/index(?:\.html)?[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # 4. Clean QR Certificate Verification: /verify/VYM-... -> /verify/index.html?id=VYM-...
  RewriteRule ^verify/([A-Za-z0-9_-]+)/?$ verify/index.html?id=$1 [L,QSA]

  # 4b. Careers fix: redirect /careers/ → /careers (so relative CSS paths resolve from /)
  RewriteRule ^careers/$ /careers [R=301,L]
  # 4c. Internal rewrite /careers → careers.html
  RewriteRule ^careers$ careers.html [L]

  # 5. External 301 Redirect: Strip .html extension from browser address bar
  # E.g. https://vyomantratech.com/about.html -> https://vyomantratech.com/about
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 6. Internal Rewrite: Map extensionless URL to existing .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block private files that must never be downloaded directly
# (data/, logs/, uploads/certificates/, scratch/, scripts/, templates/ also have their own .htaccess)
<FilesMatch "(?i)(\.(sql|md|mjs|log)$|^custom_template_downloaded\.docx$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "^\.git">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
